# VeriTruth environment configuration.
# Copy to `.env` and fill in real values. Never commit `.env`.

# Google Gemini API key -> https://aistudio.google.com/app/apikey
# If empty/invalid, the agent degrades to classifier-only mode (degraded: true).
GEMINI_API_KEY=

# Gemini model name used by the LangGraph agent.
GEMINI_MODEL=gemini-1.5-flash

# Google Fact Check Tools API key -> https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
# If empty, corpus building falls back to 25 built-in seed fact-checks.
GOOGLE_FACTCHECK_API_KEY=

# Base URL of the VeriTruth FastAPI backend (used by the Streamlit UI).
VERITRUTH_API_URL=http://localhost:8000

# Paths (relative to repo root). Defaults are fine for local development.
VERITRUTH_MODEL_DIR=models
VERITRUTH_VECTORDB_DIR=vectordb
VERITRUTH_DATA_DIR=data
VERITRUTH_DB_PATH=data/feedback.sqlite3

# Embedding model for ChromaDB.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Transformer training toggles. Set FORCE_BASELINE=1 to skip transformer entirely.
FORCE_BASELINE=0
TRANSFORMER_MODEL=distilbert-base-uncased

# Agent guardrails.
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_TOOL_CALLS=6

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Set to 1 to route agent tool calls through the four MCP stdio servers.
# 0 (default) calls the same functions in-process — faster, identical results.
AGENT_USE_MCP=0

# Explainer backend: shap | lime | occlusion (blank = auto, SHAP first).
EXPLAINER_BACKEND=

# Comma-separated CORS origins for the API (* allows all).
CORS_ORIGINS=*
