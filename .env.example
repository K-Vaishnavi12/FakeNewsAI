# ---------------------------------------------------------------------------
# VeritasCheck configuration. Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file. NEVER expose these keys to the frontend.
# ---------------------------------------------------------------------------

# --- News API -------------------------------------------------------------
# Get a key from https://newsapi.org
NEWS_API_KEY=your_news_api_key_here
NEWS_API_URL=https://newsapi.org/v2/everything
NEWS_API_TIMEOUT_SECONDS=8
NEWS_API_PAGE_SIZE=10

# --- NVIDIA (OpenAI-compatible endpoint) ----------------------------------
# Get a key from https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_TIMEOUT_SECONDS=60
NVIDIA_TEMPERATURE=0.2
NVIDIA_MAX_TOKENS=2048

# --- Application ----------------------------------------------------------
MODEL_DIR=artifacts
MAX_INPUT_CHARS=20000
# Backend base URL used by the Streamlit frontend.
BACKEND_URL=http://127.0.0.1:8000
