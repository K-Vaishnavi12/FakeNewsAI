# Copy this file to .env and fill values
NEWSAPI_KEY='39f6bffedb5f463bab17fe870dbd0ec5'

# LLM Provider: 'hf' (Hugging Face Transformer model)
LLM_PROVIDER=hf

# Hugging Face Model Name (e.g. 'gpt2', 'distilgpt2', 'meta-llama/Llama-2-7b-chat-hf', etc.)
LOCAL_HF_MODEL=gpt2
HF_TOKEN=''

# Model mode: 'local' (joblib TF-IDF classifier) or 'llm' (Hugging Face pipeline)
MODEL_MODE=local

# Flask runtime (safe local defaults)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
