# Copy this file to .env and fill values
NEWSAPI_KEY='39f6bffedb5f463bab17fe870dbd0ec5'
# Which LLM provider to use: 'hf' (local Hugging Face), 'gemini'
LLM_PROVIDER=hf
# GOOGLE_API_KEY: REMOVE any real API keys from this file. Use service account JSON instead.
GOOGLE_API_KEY=''

# If using Google Gemini prefer service account JSON referenced by:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# MODEL_MODE: 'llm' (use Gemini/Hugging Face for classification) or 'local' (use joblib model)
MODEL_MODE=llm

# Local Hugging Face model name (used when LLM_PROVIDER=hf). Example: 'gpt2' or a model you have available.
LOCAL_HF_MODEL=gpt2
