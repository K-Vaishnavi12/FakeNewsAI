# Copy this file to server/.env and fill in real values.
# server/.env is gitignored. NEVER commit real credentials to this file.

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# NewsAPI.org key. Optional: if omitted, the backend transparently falls back
# to the keyless Google News RSS feed.
NEWSAPI_KEY=YOUR_NEWS_API_KEY_HERE

# Hugging Face token, only needed for gated models.
HF_TOKEN=YOUR_HF_TOKEN_HERE

# Google Gemini API key, only needed when LLM_PROVIDER=gemini.
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# ---------------------------------------------------------------------------
# LLM synthesis (optional, OFF by default)
# ---------------------------------------------------------------------------
# The verdict is produced by a deterministic rule engine. Enabling this adds an
# advisory pass that only rewrites prose; it can never change a verdict.
ENABLE_LLM=false

# 'hf' for a local transformers model, 'gemini' for the Google API.
LLM_PROVIDER=hf

# Must be an INSTRUCTION-TUNED model. Base models such as gpt2 cannot follow
# the prompt or emit JSON and will silently produce nothing useful.
LOCAL_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# 'local' = joblib TF-IDF classifier.
MODEL_MODE=local

# ---------------------------------------------------------------------------
# HTTP / security
# ---------------------------------------------------------------------------
# Comma-separated allow-list. Never use '*'.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum characters accepted for analysis.
MAX_INPUT_CHARS=10000

# Maximum articles a single request may fetch.
MAX_PAGE_SIZE=50

# Flask-Limiter rules (per client IP).
RATE_LIMIT_DEFAULT=200 per hour
RATE_LIMIT_ANALYZE=20 per minute;300 per hour
RATE_LIMIT_TRAIN=2 per hour

# Use redis://localhost:6379 when running multiple workers, otherwise each
# worker enforces its own independent limit.
RATE_LIMIT_STORAGE_URI=memory://

# Retraining is expensive and overwrites the deployed model. Keep it off.
ENABLE_TRAIN_ENDPOINT=false

# ---------------------------------------------------------------------------
# Caching & logging
# ---------------------------------------------------------------------------
NEWS_CACHE_TTL_SECONDS=600
NEWS_CACHE_MAX_ENTRIES=256
LOG_LEVEL=INFO
